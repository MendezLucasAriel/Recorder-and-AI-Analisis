# Gemini API Key (obtener gratis en https://aistudio.google.com)
GEMINI_API_KEY=tu_api_key_aqui

# Configuración de Whisper
# Modelos disponibles: tiny, base, small, medium, large-v3
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Idioma de transcripción (es para español)
TRANSCRIPTION_LANGUAGE=es

# Campaña D&D por defecto
DEFAULT_CAMPAIGN_NAME=Mi Campaña de D&D
